# ========== ENVIRONMENT SETUP ==========
# For LOCAL DEVELOPMENT: Set NODE_ENV=development
# For PRODUCTION: Set NODE_ENV=production

# ========== DATABASE CONFIGURATION ==========
# LOCAL DEVELOPMENT: Use SQLite (file-based)
TURSO_DB_URL=file:attendance.db
TURSO_AUTH_TOKEN=

# PRODUCTION: Use Turso cloud database (uncomment and replace with your Turso credentials)
# TURSO_DB_URL=libsql://your-database-url.aws-ap-south-1.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ========== SECURITY ==========
# SESSION_SECRET: Generate a strong random string (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_MIN_32_CHARS_GENERATE_RANDOM_KEY

# PRODUCTION ONLY: Secure cookies over HTTPS
# SESSION_COOKIE_SECURE=true
# TRUST_PROXY=true (required if behind reverse proxy like nginx/CloudFlare)

# ========== DEFAULT TEACHER ACCOUNT ==========
# Will be created on first startup if no teachers exist
DEFAULT_TEACHER_EMAIL=admin@wadia.ac.in
DEFAULT_TEACHER_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# For production, use a strong password (min 8 chars, mix of upper/lower/numbers/symbols)
# After first login, teacher must change this password via the dashboard

# ========== APPLICATION SETTINGS ==========
# NODE_ENV: 'development' or 'production'
NODE_ENV=development

# PORT: Server port (default 3000)
PORT=3000

# ========== RATE LIMITING ==========
# Automatically adjusted based on NODE_ENV:
# - Development: Lenient limits (1000 attempts) for testing
# - Production: Strict limits (5 logins, 10 signups, 5 codes, 10 attendance per time window)
# No configuration needed here - automatically applied by middleware/rateLimiters.js
