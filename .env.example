# Turso database connection (use local SQLite for development)
TURSO_DB_URL=file:attendance.db
TURSO_AUTH_TOKEN=

# Session secret used by express-session (use a strong random secret in production)
SESSION_SECRET=your-strong-random-session-secret-change-in-production

# Node environment (production/development)
NODE_ENV=development

# Server port
PORT=3000

# Default teacher credentials (only for development seeding)
DEFAULT_TEACHER_EMAIL=teacher@wadia.ac.in
DEFAULT_TEACHER_PASSWORD=change-this-password
